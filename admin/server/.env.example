# Copy to .env and adjust. Never commit the real .env.
# Tip: run ./install.sh instead — it writes this file for you interactively.
PORT=4000
# Bind address: 0.0.0.0 exposes on the server's public IP (e.g. 161.97.78.116)
HOST=0.0.0.0
# Public address clients use — an IP or a domain (used for the printed URL/links)
PUBLIC_URL=http://161.97.78.116:4000

# PostgreSQL connection
DATABASE_URL=postgres://arete:arete@localhost:5432/arete

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seed admin (created by `npm run seed`)
ADMIN_EMAIL=admin@arete.fit
ADMIN_PASSWORD=admin123
