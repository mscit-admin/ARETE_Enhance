# Copy to .env and adjust. Never commit the real .env.
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://arete:arete@localhost:5432/arete

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seed admin (created by `npm run seed`)
ADMIN_EMAIL=admin@arete.fit
ADMIN_PASSWORD=admin123
